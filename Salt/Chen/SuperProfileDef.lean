linear interpolation between knots `i` and `i+1`. -/
theorem Obar_panel_eq (i : ℕ) (hi : i < 220) (v : ℝ)
    (hv : v ∈ Set.Ico (1 + (i : ℝ) / 20) (1 + ((i : ℝ) + 1) / 20)) :
    Obar v = (ObarKnots i : ℝ)
      + ((ObarKnots (i+1) : ℝ) - (ObarKnots i : ℝ)) * (v - (1 + (i : ℝ) / 20)) * 20 := by
  obtain ⟨hvl, hvr⟩ := hv
  have hinn : (0 : ℝ) ≤ (i : ℝ) / 20 := by positivity
  have hi2 : (1 : ℝ) ≤ v := by linarith
  have hile : (i : ℝ) + 1 ≤ 220 := by exact_mod_cast (by omega : i + 1 ≤ 220)
  have hlt12 : v < 12 := by
    have h10 : ((i : ℝ) + 1) / 20 ≤ 11 := by rw [div_le_iff₀ (by norm_num)]; linarith
    linarith
  have hfloor : ⌊(v - 1) * 20⌋ = (i : ℤ) := by
    rw [Int.floor_eq_iff]
    refine ⟨by push_cast; nlinarith [hvl], by push_cast; nlinarith [hvr]⟩
  unfold Obar
  rw [if_neg (by linarith), if_neg (by linarith), hfloor, Int.toNat_natCast]
  unfold plVal; ring

theorem Obar_nonneg (v : ℝ) : 0 ≤ Obar v := by
  unfold Obar
  split_ifs with h1 h2
  · exact le_refl 0
  · have hv : (0 : ℝ) < v := by linarith
    positivity
  · rw [not_lt] at h1; rw [not_le] at h2
    set n := ⌊(v - 1) * 20⌋ with hn
    have hnn : (0 : ℤ) ≤ n := by rw [hn]; apply Int.le_floor.2; push_cast; nlinarith [h1]
    have hcast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hnn
    have htn : (n.toNat : ℝ) = (n : ℝ) := by exact_mod_cast hcast
    have hfl := Int.floor_le ((v - 1) * 20)
    have hfu := Int.lt_floor_add_one ((v - 1) * 20)
    rw [← hn] at hfl hfu
    set i := n.toNat with hi
    unfold plVal
    have hfrac0 : (0 : ℝ) ≤ (v - (1 + (i : ℝ) / 20)) * 20 := by rw [htn]; nlinarith [hfl]
    have hfrac1 : (v - (1 + (i : ℝ) / 20)) * 20 ≤ 1 := by rw [htn]; nlinarith [hfu]
    have hc0 := ObarKnots_nonneg i
    have hc1 := ObarKnots_nonneg (i+1)
    nlinarith [hc0, hc1, hfrac0, hfrac1]

theorem Obar_bdd (v : ℝ) : |Obar v| ≤ 2 := by
  rw [abs_le]
  refine ⟨by linarith [Obar_nonneg v], ?_⟩
  unfold Obar
  split_ifs with h1 h2
  · norm_num
  · have hv : (0 : ℝ) < v := by linarith
    have h123 : (12 : ℝ)^3 ≤ v^3 := by gcongr
    have hle : (1/10000 : ℝ)/v^3 ≤ 2 := by rw [div_le_iff₀ (by positivity)]; nlinarith [h123]
    linarith
  · rw [not_lt] at h1; rw [not_le] at h2
    set n := ⌊(v - 1) * 20⌋ with hn
    have hnn : (0 : ℤ) ≤ n := by rw [hn]; apply Int.le_floor.2; push_cast; nlinarith [h1]
    have hcast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hnn
    have htn : (n.toNat : ℝ) = (n : ℝ) := by exact_mod_cast hcast
    have hfl := Int.floor_le ((v - 1) * 20)
    have hfu := Int.lt_floor_add_one ((v - 1) * 20)
    rw [← hn] at hfl hfu
    set i := n.toNat with hi
    unfold plVal
    have hfrac0 : (0 : ℝ) ≤ (v - (1 + (i : ℝ) / 20)) * 20 := by rw [htn]; nlinarith [hfl]
    have hfrac1 : (v - (1 + (i : ℝ) / 20)) * 20 ≤ 1 := by rw [htn]; nlinarith [hfu]
    have hc0 := ObarKnots_le i
    have hc1 := ObarKnots_le (i+1)
    have hc0n := ObarKnots_nonneg i
    have hc1n := ObarKnots_nonneg (i+1)
    nlinarith [hc0, hc1, hc0n, hc1n, hfrac0, hfrac1]

theorem Obar_measurable : Measurable Obar := by
  have haff : Measurable (fun v : ℝ => (v - 1) * 20) := by fun_prop
  have hidx : Measurable (fun v : ℝ => (⌊(v - 1) * 20⌋).toNat) :=
    (measurable_from_top (f := Int.toNat)).comp (Int.measurable_floor.comp haff)
  have ha : Measurable (fun v : ℝ => (ObarKnots (⌊(v - 1) * 20⌋).toNat : ℝ)) :=
    (measurable_from_top (f := fun n : ℕ => (ObarKnots n : ℝ))).comp hidx
  have hb : Measurable (fun v : ℝ => (ObarKnots ((⌊(v - 1) * 20⌋).toNat + 1) : ℝ)) :=
    (measurable_from_top (f := fun n : ℕ => (ObarKnots (n+1) : ℝ))).comp hidx
  have hc : Measurable (fun v : ℝ => ((⌊(v - 1) * 20⌋).toNat : ℝ)) :=
    (measurable_from_top (f := fun n : ℕ => (n : ℝ))).comp hidx
  unfold Obar
  refine Measurable.ite (measurableSet_lt measurable_id measurable_const) measurable_const ?_
  refine Measurable.ite (measurableSet_le measurable_const measurable_id) (by fun_prop) ?_
  unfold plVal
  exact ha.add
    (((hb.sub ha).mul
      (measurable_id.sub (measurable_const.add (hc.div measurable_const)))).mul measurable_const)

/-- **Interval integrability** (bounded + measurable on every finite interval). -/
theorem Obar_intervalIntegrable (a b : ℝ) : IntervalIntegrable Obar volume a b := by
  rw [intervalIntegrable_iff]
  refine Measure.integrableOn_of_bounded (measure_Ioc_lt_top).ne
    Obar_measurable.aestronglyMeasurable (M := 2) (ae_of_all _ (fun x => ?_))
  rw [Real.norm_eq_abs]
  exact Obar_bdd x

/-- **Exact panel integral** = trapezoid `(c i + c (i+1)) / 40`. -/
theorem Obar_panel_integral (i : ℕ) (hi : i < 220) :
    (∫ v in (1 + (i : ℝ) / 20)..(1 + ((i : ℝ) + 1) / 20), Obar v)
      = ((ObarKnots i : ℝ) + (ObarKnots (i+1) : ℝ)) / 40 := by
  have hLR : (1 + (i : ℝ) / 20) ≤ (1 + ((i : ℝ) + 1) / 20) := by
    have : (i : ℝ) / 20 ≤ ((i : ℝ) + 1) / 20 := by gcongr; linarith
    linarith
  set ci := (ObarKnots i : ℝ) with hci
  set cj := (ObarKnots (i+1) : ℝ) with hcj
  have hcong : ∀ᵐ x ∂volume, x ∈ Set.uIoc (1+(i : ℝ) / 20) (1+((i : ℝ) + 1) / 20) →
      Obar x = (ci - (cj-ci) * 20*(1+(i : ℝ) / 20)) + ((cj-ci) * 20)*x := by
    filter_upwards [compl_mem_ae_iff.2 (measure_singleton (1 + ((i : ℝ) + 1) / 20))] with x hx hmem
    rw [Set.uIoc_of_le hLR] at hmem
    have hxR : x < 1 + ((i : ℝ) + 1) / 20 := lt_of_le_of_ne hmem.2 (by simpa using hx)
    rw [Obar_panel_eq i hi x ⟨hmem.1.le, hxR⟩]; ring
  rw [intervalIntegral.integral_congr_ae hcong, integral_line]
  field_simp; ring

/-- **Cumulative PL integral** over `[1, 1 + n/20]` = trapezoid partial sum. -/
theorem Obar_cumint (n : ℕ) (hn : n ≤ 220) :
    (∫ v in (1 : ℝ)..(1 + (n : ℝ) / 20), Obar v)
      = ∑ i ∈ Finset.range n, ((ObarKnots i : ℝ) + (ObarKnots (i+1) : ℝ)) / 40 := by
  induction n with
  | zero => simp
  | succ m ih =>
    have hm : m ≤ 220 := by omega
    have hmlt : m < 220 := by omega
    have hcast : ((m : ℝ) + 1) = ((m+1 : ℕ) : ℝ) := by push_cast; ring
    rw [Finset.sum_range_succ, ← ih hm, ← Obar_panel_integral m hmlt,
        intervalIntegral.integral_add_adjacent_intervals
          (Obar_intervalIntegrable 1 (1 + (m : ℝ) / 20))
          (Obar_intervalIntegrable (1 + (m : ℝ) / 20) (1 + ((m : ℝ) + 1) / 20)), hcast]

theorem Obar_sum_eq_220 :
    ∑ i ∈ Finset.range 220, ((ObarKnots i : ℝ) + (ObarKnots (i+1) : ℝ)) / 40
      = 11289141/16000000 := by
  have hnat : (∑ i ∈ Finset.range 220, (ObarNum i + ObarNum (i+1))) = 282228525 := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, ObarNum, obarNumList,
      List.getD_cons_zero, List.getD_cons_succ]
  have hstep : ∀ i ∈ Finset.range 220,
      ((ObarKnots i : ℝ) + (ObarKnots (i+1) : ℝ)) / 40
        = ((ObarNum i : ℝ) + (ObarNum (i+1) : ℝ)) / 400000000 := by
    intro i _; unfold ObarKnots; push_cast; ring
  rw [Finset.sum_congr rfl hstep, ← Finset.sum_div,
      show (∑ i ∈ Finset.range 220, ((ObarNum i : ℝ)+(ObarNum (i+1) : ℝ)))
        = ((∑ i ∈ Finset.range 220, (ObarNum i + ObarNum (i+1)) : ℕ) : ℝ) by push_cast; ring,
      hnat]
  norm_num

theorem Obar_sum_eq_40 :
    ∑ i ∈ Finset.range 40, ((ObarKnots i : ℝ) + (ObarKnots (i+1) : ℝ)) / 40
      = 61872301/100000000 := by
  have hnat : (∑ i ∈ Finset.range 40, (ObarNum i + ObarNum (i+1))) = 247489204 := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, ObarNum, obarNumList,
      List.getD_cons_zero, List.getD_cons_succ]
  have hstep : ∀ i ∈ Finset.range 40,
      ((ObarKnots i : ℝ) + (ObarKnots (i+1) : ℝ)) / 40
        = ((ObarNum i : ℝ) + (ObarNum (i+1) : ℝ)) / 400000000 := by
    intro i _; unfold ObarKnots; push_cast; ring
  rw [Finset.sum_congr rfl hstep, ← Finset.sum_div,
      show (∑ i ∈ Finset.range 40, ((ObarNum i : ℝ)+(ObarNum (i+1) : ℝ)))
        = ((∑ i ∈ Finset.range 40, (ObarNum i + ObarNum (i+1)) : ℕ) : ℝ) by push_cast; ring,
      hnat]
  norm_num

/-- `∫_3^12 Obar = 34739321/400000000` (the odd budget's head; the `[1,3)` flat is excluded). -/
theorem Obar_int_3_12 : (∫ w in (3 : ℝ)..12, Obar w) = 34739321/400000000 := by
  have h12 := Obar_cumint 220 (le_refl 220)
  have h3 := Obar_cumint 40 (by norm_num)
  rw [Obar_sum_eq_220] at h12
  rw [Obar_sum_eq_40] at h3
  have e12 : (1 : ℝ) + ((220 : ℕ) : ℝ) / 20 = 12 := by norm_num
  have e3 : (1 : ℝ) + ((40 : ℕ) : ℝ) / 20 = 3 := by norm_num
  rw [e12] at h12
  rw [e3] at h3
  have hadd : (∫ w in (1 : ℝ)..12, Obar w)
      = (∫ w in (1 : ℝ)..3, Obar w) + ∫ w in (3 : ℝ)..12, Obar w :=
    (intervalIntegral.integral_add_adjacent_intervals
      (Obar_intervalIntegrable 1 3) (Obar_intervalIntegrable 3 12)).symm
  linarith [h12, h3, hadd]

/-- **Odd budget.**  `∫_3^b Obar ≤ 11/125` for every `b ≥ 3` (the `hObound` SS1 consumes). -/
theorem Obar_integral_le : ∀ b, 3 ≤ b → (∫ w in (3 : ℝ)..b, Obar w) ≤ 11/125 := by
  intro b hb
  have hle : (34739321/400000000 : ℝ) ≤ 11/125 := by norm_num
  rcases le_or_gt b 12 with hb12 | hb12
  · have hsplit : (∫ w in (3 : ℝ)..12, Obar w)
        = (∫ w in (3 : ℝ)..b, Obar w) + ∫ w in b..12, Obar w :=
      (intervalIntegral.integral_add_adjacent_intervals
        (Obar_intervalIntegrable 3 b) (Obar_intervalIntegrable b 12)).symm
    have htail0 : 0 ≤ ∫ w in b..12, Obar w :=
      intervalIntegral.integral_nonneg hb12 (fun x _ => Obar_nonneg x)
    have h312 := Obar_int_3_12
    linarith
  · have hsplit : (∫ w in (3 : ℝ)..b, Obar w)
        = (∫ w in (3 : ℝ)..12, Obar w) + ∫ w in (12 : ℝ)..b, Obar w :=
      (intervalIntegral.integral_add_adjacent_intervals
        (Obar_intervalIntegrable 3 12) (Obar_intervalIntegrable 12 b)).symm
    have htaileq : (∫ w in (12 : ℝ)..b, Obar w) = ∫ w in (12 : ℝ)..b, (1/10000)/w^3 := by
      apply intervalIntegral.integral_congr
      intro x hx; rw [Set.uIcc_of_le hb12.le] at hx; exact Obar_tail_eq x hx.1
    have htailbd : (∫ w in (12 : ℝ)..b, (1/10000 : ℝ)/w^3) ≤ (1/10000)/(2*12^2) :=
      tail_integral_le (by norm_num) (by norm_num) hb12.le
    have h312 := Obar_int_3_12
    have hbudget : (34739321/400000000 : ℝ) + (1/10000)/(2*12^2) ≤ 11/125 := by norm_num
    linarith

