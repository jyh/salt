/-- Knot numerator lookup (natural, zero past the table). -/
def EbarNum (i : ℕ) : ℕ := ebarNumList.getD i 0

/-- Knot value `= numerator / 10⁷` (nonneg by construction). -/
noncomputable def EbarKnots (i : ℕ) : ℚ := (EbarNum i : ℚ) / 10000000

theorem EbarKnots_nonneg (i : ℕ) : (0 : ℝ) ≤ (EbarKnots i : ℝ) := by
  unfold EbarKnots; push_cast; positivity

theorem EbarNum_le (i : ℕ) : EbarNum i ≤ 20000000 := by
  have hall : ∀ x ∈ ebarNumList, x ≤ 20000000 := by decide
  unfold EbarNum
  rcases lt_or_ge i ebarNumList.length with h | h
  · rw [List.getD_eq_getElem _ _ h]; exact hall _ (List.getElem_mem h)
  · rw [List.getD_eq_default (hn := h)]; exact Nat.zero_le _

theorem EbarKnots_le (i : ℕ) : (EbarKnots i : ℝ) ≤ 2 := by
  have h : (EbarNum i : ℝ) ≤ 20000000 := by exact_mod_cast EbarNum_le i
  unfold EbarKnots; push_cast; rw [div_le_iff₀ (by norm_num)]; linarith

/-- The even PL profile: `0` below `2`, PL on `[2,12)`, power tail `K/v³` from `12`. -/
noncomputable def Ebar (v : ℝ) : ℝ :=
  if v < 2 then 0
  else if 12 ≤ v then (1/10000) / v^3
  else plVal EbarKnots 2 (⌊(v - 2) * 20⌋).toNat v

theorem Ebar_tail_eq (v : ℝ) (hv : 12 ≤ v) : Ebar v = (1/10000) / v^3 := by
  unfold Ebar; rw [if_neg (by linarith), if_pos hv]

/-- **Panel equation (half-open).**  On `Ico (2 + i/20) (2 + (i+1) / 20)`, `Ebar` is the
linear interpolation between knots `i` and `i+1`. -/
theorem Ebar_panel_eq (i : ℕ) (hi : i < 200) (v : ℝ)
    (hv : v ∈ Set.Ico (2 + (i : ℝ) / 20) (2 + ((i : ℝ) + 1) / 20)) :
    Ebar v = (EbarKnots i : ℝ)
      + ((EbarKnots (i+1) : ℝ) - (EbarKnots i : ℝ)) * (v - (2 + (i : ℝ) / 20)) * 20 := by
  obtain ⟨hvl, hvr⟩ := hv
  have hinn : (0 : ℝ) ≤ (i : ℝ) / 20 := by positivity
  have hi2 : (2 : ℝ) ≤ v := by linarith
  have hile : (i : ℝ) + 1 ≤ 200 := by exact_mod_cast (by omega : i + 1 ≤ 200)
  have hlt12 : v < 12 := by
    have h10 : ((i : ℝ) + 1) / 20 ≤ 10 := by rw [div_le_iff₀ (by norm_num)]; linarith
    linarith
  have hfloor : ⌊(v - 2) * 20⌋ = (i : ℤ) := by
    rw [Int.floor_eq_iff]
    refine ⟨by push_cast; nlinarith [hvl], by push_cast; nlinarith [hvr]⟩
  unfold Ebar
  rw [if_neg (by linarith), if_neg (by linarith), hfloor, Int.toNat_natCast]
  unfold plVal; ring

theorem Ebar_nonneg (v : ℝ) : 0 ≤ Ebar v := by
  unfold Ebar
  split_ifs with h1 h2
  · exact le_refl 0
  · have hv : (0 : ℝ) < v := by linarith
    positivity
  · rw [not_lt] at h1; rw [not_le] at h2
    set n := ⌊(v - 2) * 20⌋ with hn
    have hnn : (0 : ℤ) ≤ n := by rw [hn]; apply Int.le_floor.2; push_cast; nlinarith [h1]
    have hcast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hnn
    have htn : (n.toNat : ℝ) = (n : ℝ) := by exact_mod_cast hcast
    have hfl := Int.floor_le ((v - 2) * 20)
    have hfu := Int.lt_floor_add_one ((v - 2) * 20)
    rw [← hn] at hfl hfu
    set i := n.toNat with hi
    unfold plVal
    have hfrac0 : (0 : ℝ) ≤ (v - (2 + (i : ℝ) / 20)) * 20 := by rw [htn]; nlinarith [hfl]
    have hfrac1 : (v - (2 + (i : ℝ) / 20)) * 20 ≤ 1 := by rw [htn]; nlinarith [hfu]
    have hc0 := EbarKnots_nonneg i
    have hc1 := EbarKnots_nonneg (i+1)
    nlinarith [hc0, hc1, hfrac0, hfrac1]

theorem Ebar_bdd (v : ℝ) : |Ebar v| ≤ 2 := by
  rw [abs_le]
  refine ⟨by linarith [Ebar_nonneg v], ?_⟩
  unfold Ebar
  split_ifs with h1 h2
  · norm_num
  · have hv : (0 : ℝ) < v := by linarith
    have h123 : (12 : ℝ)^3 ≤ v^3 := by gcongr
    have hle : (1/10000 : ℝ)/v^3 ≤ 2 := by rw [div_le_iff₀ (by positivity)]; nlinarith [h123]
    linarith
  · rw [not_lt] at h1; rw [not_le] at h2
    set n := ⌊(v - 2) * 20⌋ with hn
    have hnn : (0 : ℤ) ≤ n := by rw [hn]; apply Int.le_floor.2; push_cast; nlinarith [h1]
    have hcast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hnn
    have htn : (n.toNat : ℝ) = (n : ℝ) := by exact_mod_cast hcast
    have hfl := Int.floor_le ((v - 2) * 20)
    have hfu := Int.lt_floor_add_one ((v - 2) * 20)
    rw [← hn] at hfl hfu
    set i := n.toNat with hi
    unfold plVal
    have hfrac0 : (0 : ℝ) ≤ (v - (2 + (i : ℝ) / 20)) * 20 := by rw [htn]; nlinarith [hfl]
    have hfrac1 : (v - (2 + (i : ℝ) / 20)) * 20 ≤ 1 := by rw [htn]; nlinarith [hfu]
    have hc0 := EbarKnots_le i
    have hc1 := EbarKnots_le (i+1)
    have hc0n := EbarKnots_nonneg i
    have hc1n := EbarKnots_nonneg (i+1)
    nlinarith [hc0, hc1, hc0n, hc1n, hfrac0, hfrac1]

theorem Ebar_measurable : Measurable Ebar := by
  have haff : Measurable (fun v : ℝ => (v - 2) * 20) := by fun_prop
  have hidx : Measurable (fun v : ℝ => (⌊(v - 2) * 20⌋).toNat) :=
    (measurable_from_top (f := Int.toNat)).comp (Int.measurable_floor.comp haff)
  have ha : Measurable (fun v : ℝ => (EbarKnots (⌊(v - 2) * 20⌋).toNat : ℝ)) :=
    (measurable_from_top (f := fun n : ℕ => (EbarKnots n : ℝ))).comp hidx
  have hb : Measurable (fun v : ℝ => (EbarKnots ((⌊(v - 2) * 20⌋).toNat + 1) : ℝ)) :=
    (measurable_from_top (f := fun n : ℕ => (EbarKnots (n+1) : ℝ))).comp hidx
  have hc : Measurable (fun v : ℝ => ((⌊(v - 2) * 20⌋).toNat : ℝ)) :=
    (measurable_from_top (f := fun n : ℕ => (n : ℝ))).comp hidx
  unfold Ebar
  refine Measurable.ite (measurableSet_lt measurable_id measurable_const) measurable_const ?_
  refine Measurable.ite (measurableSet_le measurable_const measurable_id) (by fun_prop) ?_
  unfold plVal
  exact ha.add
    (((hb.sub ha).mul
      (measurable_id.sub (measurable_const.add (hc.div measurable_const)))).mul measurable_const)

/-- **Interval integrability** (bounded + measurable on every finite interval). -/
theorem Ebar_intervalIntegrable (a b : ℝ) : IntervalIntegrable Ebar volume a b := by
  rw [intervalIntegrable_iff]
  refine Measure.integrableOn_of_bounded (measure_Ioc_lt_top).ne
    Ebar_measurable.aestronglyMeasurable (M := 2) (ae_of_all _ (fun x => ?_))
  rw [Real.norm_eq_abs]
  exact Ebar_bdd x

/-- **Exact panel integral** = trapezoid `(c i + c (i+1)) / 40`. -/
theorem Ebar_panel_integral (i : ℕ) (hi : i < 200) :
    (∫ v in (2 + (i : ℝ) / 20)..(2 + ((i : ℝ) + 1) / 20), Ebar v)
      = ((EbarKnots i : ℝ) + (EbarKnots (i+1) : ℝ)) / 40 := by
  have hLR : (2 + (i : ℝ) / 20) ≤ (2 + ((i : ℝ) + 1) / 20) := by
    have : (i : ℝ) / 20 ≤ ((i : ℝ) + 1) / 20 := by gcongr; linarith
    linarith
  set ci := (EbarKnots i : ℝ) with hci
  set cj := (EbarKnots (i+1) : ℝ) with hcj
  have hcong : ∀ᵐ x ∂volume, x ∈ Set.uIoc (2+(i : ℝ) / 20) (2+((i : ℝ) + 1) / 20) →
      Ebar x = (ci - (cj-ci) * 20*(2+(i : ℝ) / 20)) + ((cj-ci) * 20)*x := by
    filter_upwards [compl_mem_ae_iff.2 (measure_singleton (2 + ((i : ℝ) + 1) / 20))] with x hx hmem
    rw [Set.uIoc_of_le hLR] at hmem
    have hxR : x < 2 + ((i : ℝ) + 1) / 20 := lt_of_le_of_ne hmem.2 (by simpa using hx)
    rw [Ebar_panel_eq i hi x ⟨hmem.1.le, hxR⟩]; ring
  rw [intervalIntegral.integral_congr_ae hcong, integral_line]
  field_simp; ring

/-- **Cumulative PL integral** over `[2, 2 + n/20]` = trapezoid partial sum. -/
theorem Ebar_cumint (n : ℕ) (hn : n ≤ 200) :
    (∫ v in (2 : ℝ)..(2 + (n : ℝ) / 20), Ebar v)
      = ∑ i ∈ Finset.range n, ((EbarKnots i : ℝ) + (EbarKnots (i+1) : ℝ)) / 40 := by
  induction n with
  | zero => simp
  | succ m ih =>
    have hm : m ≤ 200 := by omega
    have hmlt : m < 200 := by omega
    have hcast : ((m : ℝ) + 1) = ((m+1 : ℕ) : ℝ) := by push_cast; ring
    rw [Finset.sum_range_succ, ← ih hm, ← Ebar_panel_integral m hmlt,
        intervalIntegral.integral_add_adjacent_intervals
          (Ebar_intervalIntegrable 2 (2 + (m : ℝ) / 20))
          (Ebar_intervalIntegrable (2 + (m : ℝ) / 20) (2 + ((m : ℝ) + 1) / 20)), hcast]

theorem Ebar_sum_eq :
    ∑ i ∈ Finset.range 200, ((EbarKnots i : ℝ) + (EbarKnots (i+1) : ℝ)) / 40
      = 112618127/200000000 := by
  have hnat : (∑ i ∈ Finset.range 200, (EbarNum i + EbarNum (i+1))) = 225236254 := by
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, EbarNum, ebarNumList,
      List.getD_cons_zero, List.getD_cons_succ]
  have hstep : ∀ i ∈ Finset.range 200,
      ((EbarKnots i : ℝ) + (EbarKnots (i+1) : ℝ)) / 40
        = ((EbarNum i : ℝ) + (EbarNum (i+1) : ℝ)) / 400000000 := by
    intro i _; unfold EbarKnots; push_cast; ring
  rw [Finset.sum_congr rfl hstep, ← Finset.sum_div,
      show (∑ i ∈ Finset.range 200, ((EbarNum i : ℝ)+(EbarNum (i+1) : ℝ)))
        = ((∑ i ∈ Finset.range 200, (EbarNum i + EbarNum (i+1)) : ℕ) : ℝ) by push_cast; ring,
      hnat]
  norm_num

theorem Ebar_int_2_12 : (∫ v in (2 : ℝ)..12, Ebar v) = 112618127/200000000 := by
  have h := Ebar_cumint 200 (le_refl 200)
  rw [Ebar_sum_eq] at h
  rw [show (12 : ℝ) = 2 + ((200 : ℕ) : ℝ) / 20 by norm_num]
  exact h

/-- **Even budget.**  `∫_2^b Ebar ≤ 43/75` for every `b ≥ 2` (the `hEbound` SS1 consumes). -/
theorem Ebar_integral_le : ∀ b, 2 ≤ b → (∫ v in (2 : ℝ)..b, Ebar v) ≤ 43/75 := by
  intro b hb
  have hle : (112618127/200000000 : ℝ) ≤ 43/75 := by norm_num
  rcases le_or_gt b 12 with hb12 | hb12
  · have hsplit : (∫ v in (2 : ℝ)..12, Ebar v)
        = (∫ v in (2 : ℝ)..b, Ebar v) + ∫ v in b..12, Ebar v :=
      (intervalIntegral.integral_add_adjacent_intervals
        (Ebar_intervalIntegrable 2 b) (Ebar_intervalIntegrable b 12)).symm
    have htail0 : 0 ≤ ∫ v in b..12, Ebar v :=
      intervalIntegral.integral_nonneg hb12 (fun x _ => Ebar_nonneg x)
    have h212 := Ebar_int_2_12
    linarith
  · have hsplit : (∫ v in (2 : ℝ)..b, Ebar v)
        = (∫ v in (2 : ℝ)..12, Ebar v) + ∫ v in (12 : ℝ)..b, Ebar v :=
      (intervalIntegral.integral_add_adjacent_intervals
        (Ebar_intervalIntegrable 2 12) (Ebar_intervalIntegrable 12 b)).symm
    have htaileq : (∫ v in (12 : ℝ)..b, Ebar v) = ∫ v in (12 : ℝ)..b, (1/10000)/v^3 := by
      apply intervalIntegral.integral_congr
      intro x hx; rw [Set.uIcc_of_le hb12.le] at hx; exact Ebar_tail_eq x hx.1
    have htailbd : (∫ v in (12 : ℝ)..b, (1/10000 : ℝ)/v^3) ≤ (1/10000)/(2*12^2) :=
      tail_integral_le (by norm_num) (by norm_num) hb12.le
    have h212 := Ebar_int_2_12
    have hbudget : (112618127/200000000 : ℝ) + (1/10000)/(2*12^2) ≤ 43/75 := by norm_num
    linarith

