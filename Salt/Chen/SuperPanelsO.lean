def EbarCum (m : ℕ) : ℕ := ebarCumList.getD m 0

theorem EbarCum_rec : ∀ m, m < 200 → EbarCum (m+1) = EbarCum m + EbarNum m + EbarNum (m+1) := by
  decide

theorem Ebar_cumsum : ∀ m, m ≤ 200 →
    (∑ k ∈ Finset.range m, (EbarNum k + EbarNum (k+1))) = EbarCum m := by
  intro m
  induction m with
  | zero => intro _; simp only [Finset.range_zero, Finset.sum_empty]; rfl
  | succ n ih => intro hm; rw [Finset.sum_range_succ, ih (by omega), EbarCum_rec n (by omega)]; omega

theorem Ebar_cum_val (m : ℕ) (hm : m ≤ 200) :
    (∫ v in (2:ℝ)..(2 + (m:ℝ)/20), Ebar v) = (EbarCum m : ℝ)/400000000 := by
  rw [Ebar_cumint m hm]
  have hstep : ∀ k ∈ Finset.range m,
      ((EbarKnots k:ℝ)+(EbarKnots (k+1):ℝ))/40 = ((EbarNum k:ℝ)+(EbarNum (k+1):ℝ))/400000000 := by
    intro k _; unfold EbarKnots; push_cast; ring
  rw [Finset.sum_congr rfl hstep, ← Finset.sum_div,
      show (∑ k ∈ Finset.range m, ((EbarNum k:ℝ)+(EbarNum (k+1):ℝ)))
        = ((∑ k ∈ Finset.range m, (EbarNum k + EbarNum (k+1)) : ℕ):ℝ) by push_cast; ring,
      Ebar_cumsum m hm]

/-- Partial forward panel integral: `∫_{L}^a Ebar` for `a` inside Ebar panel `i` (trapezoid). -/
theorem Ebar_int_L_a (i : ℕ) (hi : i < 200) (a : ℝ)
    (haL : (2:ℝ) + (i:ℝ)/20 ≤ a) (haR : a ≤ 2 + ((i:ℝ)+1)/20) :
    (∫ u in (2 + (i:ℝ)/20)..a, Ebar u)
      = (EbarKnots i:ℝ) * (a - (2 + (i:ℝ)/20))
        + ((EbarKnots (i+1):ℝ) - (EbarKnots i:ℝ)) * 10 * (a - (2 + (i:ℝ)/20))^2 := by
  set L := (2 + (i:ℝ)/20) with hLdef
  set ci := (EbarKnots i : ℝ) with hci
  set cj := (EbarKnots (i+1) : ℝ) with hcj
  have hcong : ∀ᵐ x ∂volume, x ∈ Set.uIoc L a →
      Ebar x = (ci - (cj-ci)*20*L) + ((cj-ci)*20)*x := by
    filter_upwards [compl_mem_ae_iff.2 (measure_singleton a)] with x hx hmem
    rw [Set.uIoc_of_le haL] at hmem
    have hxa : x < a := lt_of_le_of_ne hmem.2 (by simpa using hx)
    have hxR : x < 2 + ((i:ℝ)+1)/20 := lt_of_lt_of_le hxa haR
    rw [Ebar_panel_eq i hi x ⟨hmem.1.le, hxR⟩]; ring
  rw [intervalIntegral.integral_congr_ae hcong, integral_line]
  ring

/-- The key `hSO` integral reduction: `∫_{w-1}^12 Ebar` as an explicit rational quadratic in `w`,
for `w-1` inside Ebar panel `i` (cumulative head + partial panel remainder). -/
theorem hSO_int_reduce (i : ℕ) (hi : i < 200) (w : ℝ)
    (hwL : (2:ℝ) + (i:ℝ)/20 ≤ w - 1) (hwR : w - 1 ≤ 2 + ((i:ℝ)+1)/20) :
    (∫ u in (w-1)..(12:ℝ), Ebar u)
      = 112618127/200000000 - (EbarCum i:ℝ)/400000000
        - ((EbarKnots i:ℝ) * (w-1-(2+(i:ℝ)/20))
           + ((EbarKnots (i+1):ℝ)-(EbarKnots i:ℝ))*10*(w-1-(2+(i:ℝ)/20))^2) := by
  have hi199 : (i:ℝ) ≤ 199 := by exact_mod_cast (by omega : i ≤ 199)
  have hi10 : ((i:ℝ)+1)/20 ≤ 10 := by rw [div_le_iff₀ (by norm_num)]; linarith
  have h12 : w - 1 ≤ 12 := by linarith
  have hipos : (0:ℝ) ≤ (i:ℝ)/20 := by positivity
  have hL2 : (2:ℝ) ≤ w - 1 := by linarith
  have hsplit : (∫ v in (2:ℝ)..12, Ebar v)
      = (∫ v in (2:ℝ)..(w-1), Ebar v) + ∫ v in (w-1)..12, Ebar v :=
    (intervalIntegral.integral_add_adjacent_intervals
      (Ebar_intervalIntegrable 2 (w-1)) (Ebar_intervalIntegrable (w-1) 12)).symm
  have hsplit2 : (∫ v in (2:ℝ)..(w-1), Ebar v)
      = (∫ v in (2:ℝ)..(2+(i:ℝ)/20), Ebar v) + ∫ v in (2+(i:ℝ)/20)..(w-1), Ebar v :=
    (intervalIntegral.integral_add_adjacent_intervals
      (Ebar_intervalIntegrable 2 (2+(i:ℝ)/20)) (Ebar_intervalIntegrable (2+(i:ℝ)/20) (w-1))).symm
  rw [Ebar_int_2_12] at hsplit
  rw [Ebar_cum_val i (by omega), Ebar_int_L_a i hi (w-1) hwL hwR] at hsplit2
  linarith [hsplit, hsplit2]

