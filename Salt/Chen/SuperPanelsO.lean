theorem hpt_seam (w : ℝ) (h12 : 12 ≤ w) (h13 : w ≤ 13) :
    (∫ u in (w-1)..(12:ℝ), Ebar u) + 1/2880000 ≤ Obar w * w := by
  have hint11 : (∫ u in (11:ℝ)..12, Ebar u) = 1/10000000 := by
    have hc := Ebar_cum_val 180 (by norm_num)
    rw [show (2:ℝ)+((180:ℕ):ℝ)/20 = 11 by norm_num,
        show (EbarCum 180:ℝ) = 225236214 from by rw [show EbarCum 180 = 225236214 from by decide]; norm_num] at hc
    have hadj : (∫ u in (2:ℝ)..12, Ebar u) = (∫ u in (2:ℝ)..11, Ebar u) + ∫ u in (11:ℝ)..12, Ebar u :=
      (intervalIntegral.integral_add_adjacent_intervals
        (Ebar_intervalIntegrable 2 11) (Ebar_intervalIntegrable 11 12)).symm
    rw [Ebar_int_2_12, hc] at hadj
    linarith [hadj]
  have hle : (∫ u in (w-1)..(12:ℝ), Ebar u) ≤ ∫ u in (11:ℝ)..12, Ebar u := by
    have hsplit : (∫ u in (11:ℝ)..12, Ebar u)
        = (∫ u in (11:ℝ)..(w-1), Ebar u) + ∫ u in (w-1)..12, Ebar u :=
      (intervalIntegral.integral_add_adjacent_intervals
        (Ebar_intervalIntegrable _ _) (Ebar_intervalIntegrable _ _)).symm
    have hnn : 0 ≤ ∫ u in (11:ℝ)..(w-1), Ebar u :=
      intervalIntegral.integral_nonneg (by linarith) (fun x _ => Ebar_nonneg x)
    linarith
  have hobar : Obar w = (1/10000)/w^3 := Obar_tail_eq w h12
  have hw0 : 0 < w := by linarith
  rw [hobar]
  have hrhs : (1/10000)/w^3 * w = (1/10000)/w^2 := by field_simp
  rw [hrhs]
  have hw2 : w^2 ≤ 169 := by nlinarith
  have hbnd : (161:ℝ)/360000000 ≤ (1/10000)/w^2 := by
    rw [div_le_div_iff₀ (by norm_num) (by positivity)]
    nlinarith [hw2]
  have hcomb : (∫ u in (w-1)..(12:ℝ), Ebar u) + 1/2880000 ≤ 161/360000000 := by
    have harith : (1:ℝ)/10000000 + 1/2880000 = 161/360000000 := by norm_num
    linarith [hle, hint11]
  linarith [hbnd, hcomb]

theorem hpt_tail (w : ℝ) (h13 : 13 < w) :
    (1/10000)/(2*(w-1)^2) ≤ Obar w * w := by
  have hobar : Obar w = (1/10000)/w^3 := Obar_tail_eq w (by linarith)
  have hw0 : 0 < w := by linarith
  have hw1 : 0 < w - 1 := by linarith
  rw [hobar]
  have hrhs : (1/10000)/w^3 * w = (1/10000)/w^2 := by field_simp
  rw [hrhs, div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith [mul_pos (show (0:ℝ)<w-13 by linarith) (show (0:ℝ)<w+9 by linarith)]


/-- The fixed rational tail bound `TE` feeding `hSO_reduce`: on `[1,13]` the finite integral
`∫_{max w 3 - 1}^{12} Ebar` plus the exact power-tail contribution; on `(13,∞)` the pure power
tail `K/(2(w-1)²)`. -/
noncomputable def TEfun (w : ℝ) : ℝ :=
  if w ≤ 13 then (∫ u in (max w 3 - 1)..12, Ebar u) + 1/2880000
  else (1/10000)/(2*(w-1)^2)

theorem hTE : ∀ w, (1:ℝ) ≤ w → ∀ b, max w 3 ≤ b →
    (∫ t in (max w 3)..b, Ebar (t - 1)) ≤ TEfun w := by
  intro w hw b hb
  have hshift : (∫ t in (max w 3)..b, Ebar (t - 1)) = ∫ u in (max w 3 - 1)..(b-1), Ebar u := by
    rw [intervalIntegral.integral_comp_sub_right (fun u => Ebar u) 1]
  rw [hshift]
  have hmax3 : (3:ℝ) ≤ max w 3 := le_max_right w 3
  have hac : max w 3 - 1 ≤ b - 1 := by linarith
  unfold TEfun
  rcases le_or_gt w 13 with h13 | h13
  · rw [if_pos h13]
    have hale12 : max w 3 - 1 ≤ 12 := by
      have : max w 3 ≤ 13 := max_le h13 (by norm_num); linarith
    rcases le_or_gt (b-1) 12 with hb12 | hb12
    · have hsplit : (∫ u in (max w 3 - 1)..12, Ebar u)
          = (∫ u in (max w 3 - 1)..(b-1), Ebar u) + ∫ u in (b-1)..12, Ebar u :=
        (intervalIntegral.integral_add_adjacent_intervals
          (Ebar_intervalIntegrable _ _) (Ebar_intervalIntegrable _ _)).symm
      have hnn : 0 ≤ ∫ u in (b-1)..12, Ebar u :=
        intervalIntegral.integral_nonneg hb12 (fun x _ => Ebar_nonneg x)
      linarith
    · have hsplit : (∫ u in (max w 3 - 1)..(b-1), Ebar u)
          = (∫ u in (max w 3 - 1)..12, Ebar u) + ∫ u in (12:ℝ)..(b-1), Ebar u :=
        (intervalIntegral.integral_add_adjacent_intervals
          (Ebar_intervalIntegrable _ _) (Ebar_intervalIntegrable _ _)).symm
      have htaileq : (∫ u in (12:ℝ)..(b-1), Ebar u) = ∫ u in (12:ℝ)..(b-1), (1/10000)/u^3 := by
        apply intervalIntegral.integral_congr
        intro x hx; rw [Set.uIcc_of_le hb12.le] at hx; exact Ebar_tail_eq x hx.1
      have htail : (∫ u in (12:ℝ)..(b-1), (1/10000:ℝ)/u^3) ≤ (1/10000)/(2*12^2) :=
        tail_integral_le (by norm_num) (by norm_num) hb12.le
      rw [hsplit, htaileq]
      have hval : (1/10000:ℝ)/(2*12^2) = 1/2880000 := by norm_num
      linarith [htail, hval]
  · rw [if_neg (by linarith)]
    have hmaxw : max w 3 = w := max_eq_left (by linarith)
    rw [hmaxw]
    have ha12 : (12:ℝ) < w - 1 := by linarith
    have hbb : w - 1 ≤ b - 1 := by have := hac; rw [hmaxw] at this; linarith
    have htaileq : (∫ u in (w-1)..(b-1), Ebar u) = ∫ u in (w-1)..(b-1), (1/10000)/u^3 := by
      apply intervalIntegral.integral_congr
      intro x hx; rw [Set.uIcc_of_le hbb] at hx; exact Ebar_tail_eq x (by linarith [hx.1])
    rw [htaileq]
    exact tail_integral_le (K := 1/10000) (W := w-1) (b := b-1) (by norm_num) (by linarith) hbb

theorem hpt_mul (w : ℝ) (hw : 1 ≤ w) : TEfun w ≤ Obar w * w := by
  unfold TEfun
  rcases le_or_gt w 13 with h13 | h13
  · rw [if_pos h13]
    rcases lt_or_ge w 3 with h3 | h3
    · rw [show max w 3 = 3 from max_eq_right (by linarith), show (3:ℝ)-1=2 by norm_num, Ebar_int_2_12]
      exact hpt_flat w hw h3
    · rw [show max w 3 = w from max_eq_left h3]
      rcases lt_or_ge w 12 with h12 | h12
      · exact hpt_exact w h3 h12
      · exact hpt_seam w h12 h13
  · rw [if_neg (by linarith)]
    exact hpt_tail w h13

theorem hpt (w : ℝ) (hw : 1 ≤ w) : (1/w) * TEfun w ≤ Obar w := by
  have hw0 : 0 < w := by linarith
  have hmul := hpt_mul w hw
  calc (1/w) * TEfun w ≤ (1/w) * (Obar w * w) := by
        apply mul_le_mul_of_nonneg_left hmul (by positivity)
    _ = Obar w := by field_simp

/-- **The `hSO` super-solution inequality (odd side), matching `SuperSolution`'s slot verbatim.**
`(1/w)·∫_{max w 3}^b Ebar(t-1) ≤ Obar w` for every `w ≥ 1` and top `b ≥ max w 3`. -/
theorem hSO_holds : ∀ w, (1:ℝ) ≤ w → ∀ b, max w 3 ≤ b →
    (1 / w) * ∫ t in (max w 3)..b, Ebar (t - 1) ≤ Obar w :=
  hSO_reduce Ebar Obar TEfun hTE hpt

end Salt.Chen
