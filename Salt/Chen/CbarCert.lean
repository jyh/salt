/-- Interval-integrability of the `cbar` integrand on `[a,b]` for `0 < a ≤ b < 2/3`. -/
theorem cbar_ii {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) (hb : b < 2 / 3) :
    IntervalIntegrable (fun s => Real.log (2 - 3*s) / (s * (1 - s))) volume a b := by
  apply ContinuousOn.intervalIntegrable
  apply ContinuousOn.div (ContinuousOn.log (by fun_prop) ?_) (by fun_prop) ?_
  · intro s hs; rw [Set.uIcc_of_le hab] at hs
    have : s ≤ b := hs.2
    exact (show (0:ℝ) < 2 - 3*s by linarith).ne'
  · intro s hs; rw [Set.uIcc_of_le hab] at hs
    have h1 : a ≤ s := hs.1
    have h2 : s ≤ b := hs.2
    exact (mul_pos (by linarith) (by linarith) : (0:ℝ) < s * (1 - s)).ne'

/-- **Tangent (upper) envelope for `log(2 − 3t)`.**  For `0 < 2 − 3c`, `0 < 2 − 3s`, and a rational
`Lc ≥ log(2 − 3c)`, `log(2 − 3s) ≤ Lc − 3(s − c)/(2 − 3c)` (tangent to the concave `log(2 − 3·)`). -/
theorem log_lin_le_tangent {c s Lc : ℝ} (hc : 0 < 2 - 3*c) (hs : 0 < 2 - 3*s)
    (hLc : Real.log (2 - 3*c) ≤ Lc) :
    Real.log (2 - 3*s) ≤ Lc - 3*(s - c) / (2 - 3*c) := by
  have hratio : 0 < (2 - 3*s) / (2 - 3*c) := div_pos hs hc
  have h1 : Real.log ((2 - 3*s) / (2 - 3*c)) ≤ (2 - 3*s) / (2 - 3*c) - 1 :=
    Real.log_le_sub_one_of_pos hratio
  have h2 : Real.log (2 - 3*s) - Real.log (2 - 3*c) = Real.log ((2 - 3*s) / (2 - 3*c)) := by
    rw [← Real.log_div hs.ne' hc.ne']
  have h3 : (2 - 3*s) / (2 - 3*c) - 1 = -(3*(s - c) / (2 - 3*c)) := by field_simp; ring
  linarith [h1, h2, hLc, h3]

