# the index are local-only; the CODE and aliases.json ARE tracked.
/scripts/search/.venv/
/scripts/search/index/
/scripts/search/__pycache__/

# Copyrighted source papers: never tracked (the public-gate purge list covers history)
docs/sources/*.pdf
articles/*.pdf
